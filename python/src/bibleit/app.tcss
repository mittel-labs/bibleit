Screen {
  layout: vertical;
  background: #f3f1ed;
}

Tree {
  background: #f3f1ed;
  color: #2a2a2a;
  scrollbar-size: 0 0;

  &:focus {
    & > .tree--cursor {
      background: #d8c3a5;
      color: #1f1f1f;
      text-style: bold;
    }
  }
}

ListView {
  height: 1fr;
  background: #f3f1ed;
  scrollbar-size: 0 0;
}

ListItem {
  height: auto;
  color: #2a2a2a;

  &.-highlight {
    background: #e7c878;
    color: #1f1f1f;
    text-style: italic bold;
  }

  & > Label {
    width: 100%;
    height: auto;
    padding: 1 2;
    text-wrap: wrap;
    text-overflow: fold;
  }
}

#workspace {
  width: 100%;
  height: 1fr;
}

HistoryPane {
  display: none;
  width: 42%;
  max-width: 48;
  height: 100%;
  padding: 1;
  background: #ece8e1;
  border-left: solid #d6cfc5;
}

HistoryPane.open {
  display: block;
}

#history-title {
  width: 100%;
  height: 2;
  text-style: bold;
}

#history-filter {
  width: 100%;
  height: 3;
  margin-bottom: 1;
  background: #f8f5ef;
  color: #202020;
  border: tall #b98b4d;
}

#history-list {
  width: 100%;
  height: 1fr;
}

Footer {
  background: #ece8e1;
  color: #2a2a2a;
  text-style: bold;
}

FooterKey {
  background: transparent;

  .footer-key--description {
    color: #444444;
  }
}

Search {
  layer: overlay;
  align: center top;
  background: #00000055;
}

#search-panel {
  width: 76;
  max-width: 90%;
  height: 80%;
  margin-top: 2;
  padding: 1 2;
  background: #181818;
  border: round #c89b5d;
  color: #f3f0ea;
}

#search-title {
  width: 100%;
  height: 1;
  color: #ffb347;
  text-style: bold;
}

#search-caption {
  width: 100%;
  height: 1;
  color: #a9a29a;
}

Search Input {
  width: 100%;
  height: 3;
  margin: 1 0 0 0;
  background: #202020;
  color: #f3f0ea;
  border: tall #6b655d;
  padding: 0 1;
}

Search Input:focus {
  border: tall #d97706;
}

#search-summary {
  width: 100%;
  height: 2;
  color: #a9a29a;
}

#text-search-results {
  width: 100%;
  height: 1fr;
  background: transparent;
  scrollbar-size: 0 0;
}

#text-search-results ListItem {
  background: transparent;
  color: #f3f0ea;
}

#text-search-results ListItem.-highlight {
  background: #2e2e2e;
  color: #f8f5ef;
  text-style: none;
}

#text-search-results ListItem > Label {
  padding: 0 1;
}

#text-search-results:focus ListItem.-highlight {
  background: #d7b46a;
  color: #161616;
}

StrongScreen,
ShortcutsScreen {
  layer: overlay;
  align: center middle;
  background: #00000099;
}

StrongScreen > Container,
ShortcutsScreen > Container {
  width: 72;
  max-width: 80%;
  height: auto;
  max-height: 80%;
  background: #181818;
  border: round #c89b5d;
  padding: 1 2;
  color: #f3f0ea;
}

StrongScreen Label,
ShortcutsScreen Label {
  width: 100%;
  height: auto;
  background: transparent;
  color: #f3f0ea;
  text-wrap: wrap;
  text-overflow: fold;
}

#shortcuts-title {
  width: 100%;
  height: 2;
  margin-bottom: 1;
  color: #ffb347;
  text-style: bold;
  content-align: center middle;
}

.shortcut-row {
  width: 100%;
  height: auto;
}

.shortcut-key {
  width: 14;
  min-width: 14;
  color: #ffb347;
  text-style: bold;
}

.shortcut-description {
  width: 1fr;
  color: #f3f0ea;
}

.strong-link {
  color: #d9a441;
  text-style: bold underline;
}

.strong-ref {
  color: #e7c878;
  text-style: underline;
}

.sup-note {
  color: #7c7468;
  text-style: italic;
}

StatusBar {
  dock: bottom;
  height: 2;
  background: #ece8e1;
  border-top: solid #d6cfc5;
  padding: 0 1;
}

#action-menu {
  display: none;
}

#status-left {
  width: 1fr;
  height: 1;
  color: #2a2a2a;
  overflow: hidden hidden;
  text-overflow: ellipsis;
  content-align: left middle;
}

#status-command {
  display: none;
  width: 1fr;
  height: 1;
  padding: 0;
  background: transparent;
  color: #2a2a2a;
  border: none;
}

#status-command-completions {
  display: none;
  width: 100%;
  height: 5;
  padding: 0 0 0 1;
  background: #f3f1ed;
  color: #2a2a2a;
  text-wrap: wrap;
  text-overflow: fold;
}

StatusBar.command-mode #action-menu,
StatusBar.command-mode #status-left,
StatusBar.command-mode #status-help,
StatusBar.command-mode #status-actions {
  display: none;
}

StatusBar.command-mode #status-command {
  display: block;
}

StatusBar.command-mode {
  layout: vertical;
}

StatusBar.command-mode.completions-open {
  height: 7;
}

StatusBar.command-mode.completions-open #status-command-completions {
  display: block;
}

#status-actions {
  display: none;
  width: auto;
  height: 1;
  layout: horizontal;
  align: right middle;
}

#status-help {
  width: auto;
  height: 1;
  margin-left: 1;
  color: #8d8478;
  content-align: right middle;
}

#status-actions Button {
  min-width: 9;
  height: 1;
  margin: 0 0 0 1;
  padding: 0 1;
  background: transparent;
  color: #6b655d;
  border: none;
  text-style: none;
}

#status-actions Button:hover,
#status-actions Button:focus {
  color: #1f1f1f;
  background: #e2d8cb;
}

#status-actions Button.active {
  color: #d97706;
  text-style: bold;
}

#status-actions Button:disabled {
  color: #b8b0a6;
}

StatusBar.compact {
  dock: top;
  height: 2;
  border-top: none;
  border-bottom: solid #d6cfc5;
  padding: 0 1;
}

StatusBar.compact #action-menu {
  display: block;
  min-width: 5;
  height: 1;
  margin: 0;
  padding: 0 1;
  background: transparent;
  color: #2a2a2a;
  border: none;
  text-style: bold;
}

StatusBar.compact #status-left,
StatusBar.compact #status-help,
StatusBar.compact #status-actions {
  display: none;
}

StatusBar.compact.open {
  height: 6;
}

StatusBar.compact.open #status-actions {
  display: block;
  width: 1fr;
  height: 5;
  layout: vertical;
  margin-left: 1;
}

StatusBar.compact.open #status-actions Button {
  display: block;
  width: 100%;
  min-width: 12;
  height: 1;
  margin: 0;
  padding: 0 1;
  content-align: left middle;
}

StatusBar.browser.compact {
  dock: bottom;
  height: 2;
  border-top: solid #d6cfc5;
  border-bottom: none;
}

StatusBar.browser.compact #action-menu,
StatusBar.browser.compact #status-actions {
  display: none;
}

StatusBar.browser.compact #status-left {
  display: block;
}

StatusBar.browser.compact.open {
  height: 2;
}

BibleView {
  width: 100%;
  height: 1fr;
  background: #f3f1ed;
}

BibleView.vertical {
  layout: vertical;
}

.verse-nav {
  display: none;
}

View {
  width: 1fr;
  height: 100%;
  border-right: solid #ddd4c8;
}

BibleView.vertical View {
  width: 100%;
  height: 1fr;
  border-right: none;
  border-bottom: solid #ddd4c8;
}

View:last-child {
  border-right: none;
}

BibleView.vertical View:last-child {
  border-bottom: none;
}
