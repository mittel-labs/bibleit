Screen {
  layout: vertical;
}

Tree {
  background: white;
  color: black;
  scrollbar-size: 0 0;

  &:focus {
    & > .tree--cursor {
      background: rgba(255, 166, 0, 0.481);
      text-style: bold;
    }
  }
}

ListView {
  height: 1fr;
  background: white;
  scrollbar-size: 0 0;
}

ListItem {
  height: auto;
  color: black;

  &.-highlight {
    background: rgba(255, 166, 0, 0.481);
    color: black;
    text-style: italic;
  }

  & > Label {
    width: 100%;
    height: auto;
    padding: 1 2;
    text-wrap: wrap;
    text-overflow: fold;
  }
}

Footer {
  background: white;
  text-style: bold;
}

FooterKey {
  .footer-key--description {
    color: black;
  }
}

Search {
  layer: overlay;
  align: center middle;
  background: transparent;
}

Search > Center > Middle {
  width: 42;
  height: auto;
  background: transparent;
}

Search Input {
  width: 100%;
  height: 3;

  background: rgba(255, 250, 245, 0.96);
  color: #222222;

  border: tall rgba(255, 166, 0, 0.481);

  padding: 0 1;
}

Search Input:focus {
  border: tall rgba(255, 166, 0, 0.85);
}

AutoComplete {
  width: 100%;
  margin-top: 1;
  background: transparent;
}

AutoCompleteList {
  width: 100%;

  background: rgba(255, 248, 240, 0.96);

  color: #222222;

  border: tall rgba(255, 166, 0, 0.481);

  max-height: 10;

  scrollbar-size: 0 0;
}

AutoCompleteList > .option-list--option {
  width: 100%;
  padding: 0 1;
  height: 1;
}

AutoCompleteList > .option-list--option-highlighted {
  background: rgba(255, 166, 0, 0.481);

  color: black;

  text-style: bold;
}

.autocomplete--highlight-match {
  color: #c96f00;
  text-style: bold;
}

StrongScreen {
  layer: overlay;
  align: center middle;
  background: rgba(0, 0, 0, 0.45);
}

StrongScreen > Container {
  width: 72;
  max-width: 80%;

  height: auto;
  max-height: 80%;

  background: rgba(10, 10, 10, 0.92);
  border: round rgba(255, 166, 0, 0.75);
  padding: 1 2;
  color: #f3f0ea;
}

StrongScreen Label {
  width: 100%;
  height: auto;
  background: transparent;
  color: #f3f0ea;
  text-wrap: wrap;
  text-overflow: fold;
}

.strong-link {
  color: #ffb347;
  text-style: bold underline;
}

.strong-ref {
  color: #ffd27f;
  text-style: underline;
}

.sup-note {
  color: #8c7b6b;
  text-style: italic;
}

StatusBar {
  dock: bottom;
  height: 2;
  background: rgba(248, 246, 242, 0.98);
  border-top: solid rgba(255, 166, 0, 0.12);
  padding: 0 2;
}

#status-left {
  width: 1fr;
  color: black;

  overflow: hidden hidden;
  text-overflow: ellipsis;
}

#status-right {
  width: auto;
  min-width: 32;
}

BibleView {
  width: 100%;
  height: 1fr;
  background: rgb(248, 246, 242);
}

View {
  width: 1fr;
  height: 100%;
  border-right: solid rgba(255,166,0,0.15);
}

View:last-child {
  border-right: none;
}